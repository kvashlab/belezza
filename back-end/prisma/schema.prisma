generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("CLIENT")
  phone     String?
  cpf       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  clientProfile       ClientProfile?
  professionalProfile ProfessionalProfile?
  addresses           Address[]
  notifications       Notification[]
}

model ClientProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar        String?
  totalBookings Int      @default(0)
  lastVisit     DateTime?
  tags          String?  // JSON string
  notes         String?
  appointments  Appointment[]
  favorites     Favorite[]
  reviews       Review[]
  waitlists     Waitlist[]
}

model ProfessionalProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username     String   @unique
  businessName String?
  avatar       String?
  coverImage   String?
  bio          String?
  categories   String?  // JSON array
  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  
  // Address
  city         String?
  state        String?
  neighborhood String?
  lat          Float?
  lng          Float?

  serviceLocation String @default("ambos") // "no_local", "domicilio", "ambos"
  verified        Boolean @default(false)
  socialLinks     String? // JSON string
  plan            String  @default("FREE") // "FREE" or "PREMIUM"
  requireDeposit  Boolean @default(false) // Whether to require 30% PIX deposit
  
  services     Service[]
  workingHours WorkingHour[]
  teamMembers  TeamMember[]
  portfolio    PortfolioPhoto[]
  appointments Appointment[]
  favorites    Favorite[]
  reviews      Review[]
  waitlists    Waitlist[]

  @@index([city])
  @@index([rating])
}

model Service {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          Float
  duration       Int                 // in minutes
  category       String
  appointments   Appointment[]
}

model WorkingHour {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  teamMemberId   String?
  teamMember     TeamMember?         @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  dayOfWeek      Int                 // 0-6
  startTime      String              // "09:00"
  endTime        String              // "19:00"
  isOpen         Boolean             @default(true)
}

model PortfolioPhoto {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  url            String
  category       String
  description    String?
  isBeforeAfter  Boolean             @default(false)
}

model Appointment {
  id             String              @id @default(uuid())
  clientId       String
  client         ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  teamMemberId   String?
  teamMember     TeamMember?         @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  serviceId      String
  service        Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  date           DateTime
  status         String              @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  price          Float
  duration       Int
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  review         Review?

  @@index([date])
  @@index([status])
  @@index([professionalId, date])
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String   // "Casa", "Trabalho", etc.
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  lat          Float?
  lng          Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Favorite {
  id             String              @id @default(uuid())
  clientId       String
  client         ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@unique([clientId, professionalId])
}

model Review {
  id             String              @id @default(uuid())
  clientId       String
  client         ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointmentId  String?             @unique
  appointment    Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  rating         Int                 // 1 to 5
  comment        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Waitlist {
  id             String              @id @default(uuid())
  clientId       String
  client         ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  date           String              // YYYY-MM-DD
  status         String              @default("WAITING") // WAITING, NOTIFIED
  createdAt      DateTime            @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, APPOINTMENT, WAITLIST, MARKETING
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TeamMember {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  avatar         String?
  role           String?             // e.g. "Barbeiro", "Manicure"
  
  appointments   Appointment[]
  workingHours   WorkingHour[]
}
